---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getNotes } from '../../lib/content';
const notes = await getNotes();
const fmt = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---
<BaseLayout title="Notes" description="Short write-ups on distributed systems, AWS and agentic AI.">
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Writing</p>
      <h1 style="margin:.5rem 0 2rem">Notes</h1>
      {notes.length === 0 ? <p>Nothing published yet.</p> : (
        <ul class="list">
          {notes.map((n) => (
            <li><a href={`/notes/${n.data.slug}/`}><time datetime={n.data.date.toISOString()}>{fmt.format(n.data.date)}</time>
              <span><b class="mono">{n.data.title}{n.data.draft ? ' (draft)' : ''}</b><br /><span style="color:var(--muted)">{n.data.description}</span></span></a></li>
          ))}
        </ul>
      )}
    </div>
  </section>
</BaseLayout>
