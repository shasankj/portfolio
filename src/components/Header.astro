---
import { u } from '../lib/url';
import { nav, site } from '../data/site';
const path = Astro.url.pathname;
const current = (href: string) => (path.startsWith(u(href)) ? 'page' : undefined);
---
<header class="site-header" transition:name="site-header">
  <div class="wrap">
    <a class="brand" href={u('/')} aria-label="SJ_ Shasank Jabade, home">SJ<span>_</span></a>
    <nav class="site-nav" aria-label="Main">
      {nav.map((n) => <a href={u(n.href)} aria-current={current(n.href)}>{n.label}</a>)}
      <a class="btn sm" href={u(site.resume)} target="_blank" rel="noopener">Résumé</a>
      <button class="icon-btn kbd-btn" type="button" data-open-palette aria-haspopup="dialog" aria-keyshortcuts="Control+K Meta+K" aria-label="Open command palette">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="M16 16l5 5"></path></svg>
        <span class="kbd" aria-hidden="true">⌘K</span>
      </button>
      <button class="icon-btn" type="button" id="theme-toggle" aria-label="Toggle light and dark theme">
        <svg class="theme-ico" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
          <mask id="theme-mask"><rect width="24" height="24" fill="#fff"></rect><circle class="tcut" cx="18" cy="6" r="6.5" fill="#000"></circle></mask>
          <circle class="tcore" cx="12" cy="12" r="5" fill="currentColor" mask="url(#theme-mask)"></circle>
          <g class="trays" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M12 2.2v2.3M12 19.5v2.3M2.2 12h2.3M19.5 12h2.3M5.1 5.1l1.6 1.6M17.3 17.3l1.6 1.6M5.1 18.9l1.6-1.6M17.3 6.7l1.6-1.6"></path>
          </g>
        </svg>
      </button>
    </nav>
  </div>
</header>
