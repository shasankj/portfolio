---
// Diagram conventions (see CLAUDE.md): src/diagrams/<name>.svg, elements carry data-step="N".
// A node and the edges leading INTO it share its step number.
import type { CaseStudy } from '../lib/content';
import { renderMermaidDiagram } from '../lib/mermaid-diagram';
interface Props { entry: CaseStudy }
const { entry } = Astro.props;
const { diagram, diagramAlt, steps, title } = entry.data;
const files = import.meta.glob('../diagrams/*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const mmds = import.meta.glob('../diagrams/*.mmd', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
// Hand-authored SVG wins; otherwise render <diagram>.mmd with Mermaid at build time.
const mmd = diagram ? mmds[`../diagrams/${diagram}.mmd`] : undefined;
const svg = diagram ? (files[`../diagrams/${diagram}.svg`] ?? (mmd ? await renderMermaidDiagram(mmd) : undefined)) : undefined;
---
{svg ? (
  <div class="arch" data-arch>
    <!-- The diagram stays pinned while you read the steps, so you always see what is lit. -->
    <div class="arch-pin">
      <div class="arch-bar" hidden>
        <button class="btn sm" type="button" data-play aria-pressed="false">▶ Play flow</button>
        <span class="eyebrow" data-caption-count aria-hidden="true"></span>
      </div>
      <div class="diagram-wrap">
        <div role="img" aria-label={diagramAlt ?? `Architecture diagram of ${title}`} set:html={svg} />
      </div>
      <p class="arch-caption" data-caption aria-hidden="true"></p>
    </div>
    <ol class="steps" data-steps>
      {steps.map((s, i) => <li data-step-index={i + 1} tabindex="0"><h3>{s.title}</h3><p>{s.text}</p></li>)}
    </ol>
  </div>
) : (
  <p class="todo"><b>TODO:</b> add a diagram at <code>src/diagrams/{diagram ?? '&lt;name&gt;'}.svg</code>.</p>
)}
