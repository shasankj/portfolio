---
import type { CaseStudy } from '../lib/content';
import Cover from './Cover.astro';
import Badges from './Badges.astro';
interface Props { entry: CaseStudy; base?: string }
const { entry, base = '/projects' } = Astro.props;
const d = entry.data;
---
<a class="card" href={`${base}/${d.slug}/`} data-pa data-tags={d.tags.join('|')}
   style={`--pa-light:${d.accentColor};--pa-dark:${d.accentColorDark ?? d.accentColor}`}>
  <div class="cover"><Cover seed={d.slug} label={d.status.toUpperCase()} /></div>
  <div class="body">
    <span class="status">{d.status === 'live' && <span class="dot-live" aria-hidden="true"></span>}{d.status.replace('-', ' ')}</span>
    <h3>{d.title}</h3>
    <p>{d.summary}</p>
    <Badges items={d.stack.slice(0, 5)} />
  </div>
</a>
